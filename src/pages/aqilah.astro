---
import Base from '../layouts/Base.astro'
import '../styles/global.css'
import AqilahDock from '../components/AqilahDock'
import QRCode from 'qrcode'

// ─── Invitation details ─────────────────────────────────────────────
const invite = {
  groom: 'Irsyad',
  bride: "'Aqilah",
  groomFull: 'Muhammad Irsyad Bin Abd Wahab',
  brideFull: "'Aqilah Hani Binte Alfian",
  groomParents: 'Abd Wahab Bin Abd Hamid & Hamidah Bte Abd Rahman',
  brideParents: 'Alfian Bin Ahmad & Liza Bte Ahmad',
  hashtag: '#QilsLoveAtFirstSyad',
  start: '2027-05-30T11:00:00+08:00',
  end: '2027-05-30T16:00:00+08:00',
  dayLabel: 'Ahad / Sunday',
  dateLabel: '30 May 2027',
  hijri: '23 Zulhijjah 1448H',
  timeLabel: '11.00AM – 4.00PM',
  venueName: 'The Iris @ City Plaza',
  venueAddress: '810 Geylang Rd, #04-28/37\nSingapore 409286',
  mapsQuery: 'The Iris @ City Plaza, 810 Geylang Rd, Singapore 409286',
  programme: [
    ['11.00am', 'Majlis bermula', 'Reception begins'],
    ['4.00pm', 'Majlis berakhir', 'Reception ends'],
  ],
  contacts: [
    // [name, relation, phone in international format, digits only]
    ['Abd Wahab', 'Bapa pengantin lelaki | Father of the groom', '6596583646'],
    ['Alfian', 'Bapa pengantin perempuan | Father of the bride', '6598487330'],
  ],
}

const gcalStamp = (iso: string) => new Date(iso).toISOString().replace(/[-:]|\.\d{3}/g, '')
const calendarUrl =
  'https://calendar.google.com/calendar/render?action=TEMPLATE' +
  `&text=${encodeURIComponent(`Walimatul Urus ${invite.groom} & ${invite.bride}`)}` +
  `&dates=${gcalStamp(invite.start)}/${gcalStamp(invite.end)}` +
  `&location=${encodeURIComponent(`${invite.venueName}, ${invite.venueAddress.replace(/\n/g, ', ')}`)}` +
  `&details=${encodeURIComponent(invite.hashtag)}`
const mapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(invite.mapsQuery)}&output=embed`
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(invite.mapsQuery)}`

const title = `Walimatul Urus · ${invite.groom} & ${invite.bride}`
const description = `${invite.groom} & ${invite.bride} — 30 May 2027 · ${invite.hashtag}`
const ogImage = new URL('/wedding/og.jpg', Astro.site)
const pageUrl = new URL('/aqilah', Astro.site).href

// "Father & Mother" → father (keeping the &) on one line, mother below
const hostLines = (s: string) => s.split(' & ')
// "Given Bin/Binte Father" → given name, then the bin/binte line below
const coupleLines = (s: string) => s.split(/ (?=Bin(?:te)? )/)
// QR rendered at build time as inline SVG, in the card's sage on transparent
const qrSvg = await QRCode.toString(pageUrl, {
  type: 'svg', margin: 0, errorCorrectionLevel: 'M',
  color: { dark: '#5f6b4eff', light: '#00000000' },
})
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/aqilah', Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f3ece0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/wedding/card.webp" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/kfgqpc-symbols.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/qpc-v1-p406.woff2" crossorigin />
  </Fragment>

  <!-- ─── Envelope ─────────────────────────────────────────── -->
  <div id="envelope-stage" class="stage" aria-hidden="false">
    <p class="stage-kicker">Walimatul Urus</p>
    <h1 class="stage-names">{invite.groom} <span>&amp;</span> {invite.bride}</h1>

    <button id="envelope" class="envelope" type="button" aria-label="Open the invitation">
      <span class="env-back"></span>
      <span class="env-letter">
        <img src="/wedding/card.webp" alt="" width="1200" height="1680" />
      </span>
      <span class="env-pocket"></span>
      <span class="env-flap"></span>
      <span class="env-seal"><span>I<i>&amp;</i>A</span></span>
    </button>

    <p class="stage-hint">tap the envelope to open</p>
  </div>

  <!-- ─── Card ─────────────────────────────────────────────── -->
  <main id="card" class="card" inert>
    <div class="petals" aria-hidden="true"></div>

    <section class="hero">
      <img
        src="/wedding/card.webp"
        width="1200"
        height="1680"
        alt={`Walimatul Urus — ${invite.groom} & ${invite.bride} — 30 May 2027 — ${invite.hashtag}`}
      />
    </section>

    <div class="frame">
      <section class="block reveal">
        <p class="bismillah" role="img" aria-label="بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ — In the name of Allah, the Most Gracious, the Most Merciful">&#xE802;</p>
        <p class="lead">Assalamualaikum Warahmatullahi Wabarakatuh</p>
        <p class="sub en">May Peace Be Upon You</p>
        <p class="hosts"><span class="line">{hostLines(invite.groomParents)[0]} &amp;</span><span class="line">{hostLines(invite.groomParents)[1]}</span></p>
        <p class="sub">serta | <em>with</em></p>
        <p class="hosts"><span class="line">{hostLines(invite.brideParents)[0]} &amp;</span><span class="line">{hostLines(invite.brideParents)[1]}</span></p>
        <p class="sub">Dengan segala hormatnya, kami mengundang</p>
        <p class="sub en">With much gratitude, we cordially invite</p>
        <p class="sub guest">Mr / Mrs / Ms</p>
        <p class="sub">ke Majlis Perkahwinan</p>
        <p class="sub en">to the Wedding Reception of</p>
      </section>

      <section class="block reveal">
        <p class="couple"><span class="line">{coupleLines(invite.groomFull)[0]}</span><span class="line patronym">{coupleLines(invite.groomFull)[1]}</span></p>
        <p class="amp">&amp;</p>
        <p class="couple"><span class="line">{coupleLines(invite.brideFull)[0]}</span><span class="line patronym">{coupleLines(invite.brideFull)[1]}</span></p>
      </section>

      <div class="divider reveal" aria-hidden="true"><span></span>❦<span></span></div>

      <section class="block details">
        <div class="reveal">
          <h2>Tarikh · Date</h2>
          <p class="big">{invite.dayLabel}</p>
          <p class="big">{invite.dateLabel}</p>
          <p class="sub">{invite.hijri}</p>
        </div>
        <div class="reveal">
          <h2>Masa · Time</h2>
          <p class="big">{invite.timeLabel}</p>
        </div>
        <div class="reveal">
          <h2>Tempat · Venue</h2>
          <p class="big">{invite.venueName}</p>
          <p class="sub pre">{invite.venueAddress}</p>
        </div>
        <div class="reveal map">
          <iframe
            src={mapsEmbedUrl}
            title={`Map to ${invite.venueName}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <div class="reveal buttons">
          <a class="btn" href={mapsUrl} target="_blank" rel="noopener">Google Maps</a>
          <a class="btn" href={calendarUrl} target="_blank" rel="noopener">Save the Date</a>
        </div>
      </section>

      <section class="block reveal">
        <h2>Countdown</h2>
        <div class="countdown" data-target={invite.start}>
          <div><b data-unit="d">–</b><span>Days</span></div>
          <div><b data-unit="h">–</b><span>Hours</span></div>
          <div><b data-unit="m">–</b><span>Minutes</span></div>
          <div><b data-unit="s">–</b><span>Seconds</span></div>
        </div>
      </section>

      <div class="divider reveal" aria-hidden="true"><span></span>❦<span></span></div>

      <section class="block">
        <h2 class="reveal">Aturcara · Programme</h2>
        <ol class="programme">
          {invite.programme.map(([time, ms, en]) => (
            <li class="reveal">
              <p class="time">{time}</p>
              <p class="big">{ms}</p>
              <p class="sub en">{en}</p>
            </li>
          ))}
        </ol>
      </section>

      <div class="divider reveal" aria-hidden="true"><span></span>❦<span></span></div>

      <section class="block reveal rsvp">
        <h2>RSVP</h2>
        <form id="rsvp-form">
          <label class="sr-only" for="rsvp-name">Nama · Name</label>
          <input id="rsvp-name" name="name" type="text" autocomplete="name" maxlength="60" placeholder="Nama · Name" required />
          <button class="btn solid" type="submit">Hantar · Submit</button>
          <p id="rsvp-error" class="sub small error" role="alert" hidden></p>
        </form>
        <div id="rsvp-done" hidden>
          <p class="big">See you there, <span id="rsvp-who"></span>!</p>
          <button class="btn" type="button" id="ticket-open">View your ticket</button>
        </div>
      </section>

      <section class="block reveal verse">
        <p class="ayah" lang="ar" role="img" aria-label="وَمِنۡ ءَايَٰتِهِۦٓ أَنۡ خَلَقَ لَكُم مِّنۡ أَنفُسِكُمۡ أَزۡوَٰجٗا لِّتَسۡكُنُوٓاْ إِلَيۡهَا وَجَعَلَ بَيۡنَكُم مَّوَدَّةٗ وَرَحۡمَةًۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّقَوۡمٖ يَتَفَكَّرُونَ">ﮉ ﮊ ﮋ ﮌ ﮍ ﮎ ﮏ ﮐ ﮑ ﮒ ﮓ ﮔ ﮕ ﮖﮗ ﮘ ﮙ ﮚ ﮛ ﮜ ﮝ ﮞ</p>
        <p class="sub en">
          “And among His signs is that He created for you spouses from among yourselves so that you may find
          tranquillity in them, and He placed between you affection and mercy. Indeed in that are signs for a people who give thought.”
        </p>
        <p class="sub">(Surah Ar-Rum 30:21)</p>
      </section>

      <section class="block reveal">
        <p class="sub">
          O Allah, bless this union, grant happiness and barakah to the bride and groom,
          and unite their hearts in sakinah, mawaddah wa rahmah.
        </p>
        <p class="script">{invite.groom} &amp; {invite.bride}</p>
        <p class="hashtag">{invite.hashtag}</p>
      </section>
    </div>

    <!-- bottom sheets -->
    <div id="sheet-backdrop" class="sheet-backdrop" hidden></div>
    <div id="sheet-contact" class="sheet" role="dialog" aria-label="Contact" hidden>
      <h2>Contact</h2>
      <ul>
        {invite.contacts.map(([name, role, phone]) => (
          <li>
            <div>
              <p class="big">{name}</p>
              <p class="sub small">{role}</p>
            </div>
            <div class="row">
              <a class="btn sm" href={`tel:+${phone}`}>Call</a>
              <a class="btn sm" href={`https://wa.me/${phone}`} target="_blank" rel="noopener">WhatsApp</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div id="sheet-location" class="sheet" role="dialog" aria-label="Location" hidden>
      <h2>Location</h2>
      <p class="big">{invite.venueName}</p>
      <p class="sub pre">{invite.venueAddress}</p>
      <div class="buttons">
        <a class="btn" href={mapsUrl} target="_blank" rel="noopener">Google Maps</a>
      </div>
    </div>
    <div id="sheet-share" class="sheet" role="dialog" aria-label="Share" hidden>
      <h2>Share</h2>
      <p class="sub en">Scan to open the invitation</p>
      <div class="qr" role="img" aria-label={`QR code for ${pageUrl}`} set:html={qrSvg} />
      <p class="sub small">{pageUrl.replace('https://', '')}</p>
      <div class="buttons">
        <button class="btn" type="button" id="share-native" hidden>Share…</button>
        <button class="btn" type="button" id="share-copy">Copy link</button>
      </div>
    </div>

    <!-- RSVP ticket -->
    <div id="ticket-overlay" class="ticket-overlay" role="dialog" aria-modal="true" aria-labelledby="ticket-title" hidden>
      <div class="ticket" id="ticket">
        <div class="t-main">
          <span class="t-amp" aria-hidden="true">&amp;</span>
          <p class="t-kicker">The Wedding of</p>
          <h2 id="ticket-title" class="t-names">{invite.groom}<span>&amp;</span>{invite.bride}</h2>
          <p class="t-meta">Sunday, 30 May 2027 · 11.00AM<br />{invite.venueName}</p>
          <p class="t-tag">{invite.hashtag}</p>
        </div>
        <div class="t-stub">
          <div class="t-row"><span>Admit One</span><span>No. <span id="ticket-no"></span></span></div>
          <p class="t-guest" id="ticket-guest"></p>
          <a id="wallet-btn" class="wallet-btn" href="#">
            <!-- Apple's official badge (US/UK RGB), used unmodified per the Add to Apple Wallet guidelines -->
            <img src="/wedding/aqilah/add-to-apple-wallet.svg" alt="Add to Apple Wallet" width="111" height="35" />
          </a>
        </div>
      </div>
      <button class="t-done" type="button" id="ticket-done">Done</button>
    </div>

    <div class="dock"><AqilahDock client:load calendarUrl={calendarUrl} /></div>
  </main>
</Base>

<style is:global>
  @font-face {
    font-family: 'QPC V1 P406';
    src: url('/fonts/qpc-v1-p406.woff2') format('woff2');
    font-display: swap;
  }
  @font-face {
    font-family: 'KFGQPC Symbols';
    src: url('/fonts/kfgqpc-symbols.woff2') format('woff2');
    font-display: block;
  }
  :root {
    --paper: #faf6ee;
    --paper-deep: #f3ece0;
    --sage: #5f6b4e;
    --sage-soft: #7d8770;
    --gold: #e6d9a6;
    --rose: #e8a5b3;
    --serif: 'Cormorant Garamond', Georgia, serif;
    --script: 'Pinyon Script', cursive;
  }
  html, body { background: var(--paper-deep) !important; color: var(--sage) !important; }
  body { padding: 0 !important; font-family: var(--serif) !important; font-size: 18px !important; }
  body.locked { overflow: hidden; }
</style>

<style>
  /* ── Envelope stage ─────────────────────────────────── */
  .stage {
    position: fixed; inset: 0; z-index: 50;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1.25rem; padding: 1.5rem;
    background:
      radial-gradient(ellipse at 50% 40%, #fffdf8 0%, var(--paper-deep) 70%);
    transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 600ms;
  }
  .stage.gone { opacity: 0; visibility: hidden; }
  .stage-kicker { letter-spacing: 0.35em; text-transform: uppercase; font-size: 0.8rem; color: var(--sage-soft); }
  .stage-names { font-family: var(--script); font-size: clamp(2.4rem, 10vw, 3.4rem); font-weight: 400; line-height: 1.1; text-align: center; }
  .stage-names span { font-size: 0.7em; color: var(--rose); }
  .stage-hint { font-style: italic; color: var(--sage-soft); animation: hint 2.4s ease-in-out infinite; }
  .stage.opening .stage-hint, .stage.opening .stage-kicker, .stage.opening .stage-names {
    opacity: 0; transition: opacity 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* the pulse animation would otherwise override the fade */
  .stage.opening .stage-hint { animation: none; }
  @keyframes hint { 50% { opacity: 0.45; } }

  .envelope {
    --w: min(82vw, 360px);
    --h: calc(var(--w) * 0.66);
    position: relative; width: var(--w); height: var(--h);
    margin: calc(var(--h) * 0.15) 0 0.5rem;
    perspective: 1200px; cursor: pointer;
    border: 0; padding: 0; background: none;
    animation: float 4s ease-in-out infinite;
  }
  /* static contact shadow — a filter here would repaint the rotating flap every frame */
  .envelope::before {
    content: ''; position: absolute; z-index: -1;
    left: 6%; right: 6%; bottom: -18px; height: 36px; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(70 60 40 / 0.22), transparent);
  }
  .envelope:focus-visible { outline: 2px solid var(--sage); outline-offset: 8px; border-radius: 4px; }
  @keyframes float { 50% { transform: translateY(-6px); } }
  .stage.opening .envelope { animation: none; }

  .envelope > span { position: absolute; display: block; }
  .env-back { inset: 0; background: #ead7c3; border-radius: 4px; }
  .env-letter {
    left: 6%; right: 6%; top: 5%; height: 90%;
    border-radius: 2px; overflow: hidden; background: var(--paper);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.08);
    transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1) 400ms;
    z-index: 1;
  }
  .env-letter img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .env-pocket {
    inset: 0; z-index: 2; border-radius: 4px;
    clip-path: polygon(0 0, 50% 52%, 100% 0, 100% 100%, 0 100%);
    background: #f3e6d6;
  }
  .env-pocket::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(160deg, transparent 40%, rgb(0 0 0 / 0.05));
  }
  .env-flap {
    left: 0; right: 0; top: 0; height: 58%; z-index: 3;
    background: #ecdcc8;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform-origin: top center;
    transition: transform 650ms cubic-bezier(0.65, 0, 0.35, 1), z-index 0s linear 320ms;
  }
  .env-seal {
    z-index: 4; left: 50%; top: 58%;
    width: 64px; height: 64px; margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #a3b08f, var(--sage) 60%, #4a543c);
    box-shadow: inset 0 0 0 4px rgb(255 255 255 / 0.12), 0 3px 8px rgb(0 0 0 / 0.25);
    display: grid; place-items: center;
    color: #f4efe2; font-family: var(--script); font-size: 1.45rem;
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1), opacity 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* `.envelope > span { display: block }` outranks .env-seal, which knocked out the grid centring */
  .envelope > .env-seal { display: grid; }
  .env-seal > span { line-height: 1; padding-top: 0.12em; white-space: nowrap; }
  .env-seal i { font-size: 0.7em; margin: 0 1px; opacity: 0.8; }

  .stage.opening .env-seal { transform: scale(1.25); opacity: 0; }
  .stage.opening .env-flap { transform: rotateX(180deg); z-index: 0; }
  .stage.opening .env-letter { transform: translateY(-70%); }


  /* ── Card ──────────────────────────────────────────── */
  .card {
    position: relative;
    max-width: 480px; margin: 0 auto; min-height: 100dvh;
    background: var(--paper);
    box-shadow: 0 0 60px rgb(70 60 40 / 0.12);
    padding-bottom: 6rem; overflow: hidden;
  }
  .hero img { display: block; width: 100%; height: auto; }

  .frame {
    position: relative; margin: 0 1.25rem; padding: 2.5rem 1.5rem 3rem;
    border: 1px solid var(--gold); outline: 1px solid var(--gold); outline-offset: 5px;
    text-align: center;
  }
  .block { margin: 0 0 3rem; }
  .block:last-child { margin-bottom: 0; }
  h2 {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--sage-soft); margin-bottom: 0.6rem;
  }
  .lead { font-size: 1.35rem; font-weight: 500; margin: 1rem 0 0.75rem; }
  .sub { font-size: 1.02rem; line-height: 1.6; color: var(--sage-soft); }
  .sub.en { font-style: italic; }
  .sub.small { font-size: 0.85rem; line-height: 1.35; }
  .pre { white-space: pre-line; }
  .big { font-size: 1.25rem; font-weight: 500; line-height: 1.4; }
  .hosts { font-size: 1.05rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin: 1rem 0 0.25rem; line-height: 1.5; }
  .hosts + .sub + .hosts { margin-top: 0.25rem; margin-bottom: 1rem; }
  .guest { border-top: 1px dotted var(--sage-soft); border-bottom: 1px dotted var(--sage-soft); padding: 0.5rem 0; margin: 1rem 0; }
  .lead + .sub.en { margin-top: -0.6rem; }
  .bismillah { font-family: 'KFGQPC Symbols'; font-size: clamp(1.5rem, 8.4vw, 2.35rem); line-height: 1.6; color: var(--sage); white-space: nowrap; max-width: 100%; overflow: hidden; }
  .ayah { font-family: 'QPC V1 P406'; font-size: clamp(1.2rem, 5.6vw, 1.5rem); line-height: 2.1; direction: rtl; margin-bottom: 0.75rem; word-spacing: 0.05em; }
  .couple { font-family: var(--script); font-size: clamp(1.9rem, 8vw, 2.4rem); line-height: 1.3; }
  .hosts .line, .couple .line { display: block; }
  .couple .patronym { font-size: 0.72em; }
  .amp { font-family: var(--script); font-size: 2rem; color: var(--rose); }
  .script { font-family: var(--script); font-size: 2.2rem; margin-top: 1.5rem; }
  .hashtag { letter-spacing: 0.18em; font-size: 0.85rem; margin-top: 0.5rem; color: var(--sage-soft); }

  .divider { display: flex; align-items: center; gap: 0.75rem; color: var(--rose); margin: -1rem 0 2.5rem; }
  .divider span { flex: 1; height: 1px; background: var(--gold); }

  .details > div { margin-bottom: 1.75rem; }
  .map { border: 1px solid var(--gold); padding: 4px; background: #fffdf8; }
  .map iframe { display: block; width: 100%; height: 220px; border: 0; filter: saturate(0.7) sepia(0.15); }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
  .btn {
    display: inline-block; padding: 0.55rem 1.1rem; border: 1px solid var(--sage);
    border-radius: 999px; font-size: 0.95rem; color: var(--sage);
    transition: background 200ms ease, color 200ms ease, transform 160ms ease;
  }
  .btn:hover { background: var(--sage); color: var(--paper); }
  .btn:active { transform: scale(0.97); }
  .btn.sm { padding: 0.35rem 0.8rem; font-size: 0.85rem; }

  .rsvp form { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .rsvp input {
    width: 100%; max-width: 280px; padding: 0.6rem 0.9rem; text-align: center;
    font: inherit; color: var(--sage); background: #fffdf8;
    border: 1px solid var(--gold); border-radius: 999px; outline: none;
  }
  .rsvp input:focus-visible { border-color: var(--sage); }
  .rsvp input::placeholder { color: var(--sage-soft); opacity: 0.7; }
  .btn.solid { background: var(--sage); color: var(--paper); cursor: pointer; font: inherit; }
  .btn.solid:hover { background: #4f5a40; }
  .btn.solid:disabled { opacity: 0.6; cursor: progress; }
  .error { color: #b5546a; }
  #rsvp-done .big { margin-bottom: 0.9rem; }
  #rsvp-done .btn { font-family: inherit; cursor: pointer; background: none; }

  /* ── RSVP ticket ─────────────────────────────────── */
  .ticket-overlay {
    position: fixed; inset: 0; z-index: 80;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.25rem;
    padding: 1.5rem; background: rgb(40 35 25 / 0.45);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .ticket-overlay[hidden] { display: none; }
  .ticket {
    --notch: 13px;
    width: min(78vw, 300px); text-align: center;
    filter: drop-shadow(0 18px 30px rgb(30 25 15 / 0.28));
  }
  /* two halves, each with half-circle notches cut where they meet */
  .t-main, .t-stub {
    position: relative;
    -webkit-mask: var(--m-left) left / 51% 100% no-repeat, var(--m-right) right / 51% 100% no-repeat;
    mask: var(--m-left) left / 51% 100% no-repeat, var(--m-right) right / 51% 100% no-repeat;
  }
  .t-main {
    --m-left: radial-gradient(circle var(--notch) at 0 100%, #0000 98%, #000);
    --m-right: radial-gradient(circle var(--notch) at 100% 100%, #0000 98%, #000);
    overflow: hidden; padding: 1.75rem 1.5rem 1.4rem;
    background: var(--paper); border-radius: 14px 14px 0 0; color: var(--sage);
  }
  .t-amp {
    position: absolute; right: -0.12em; top: -0.18em; z-index: 0;
    font-family: var(--script); font-size: 13rem; line-height: 1; color: var(--rose); opacity: 0.16;
  }
  .t-main > :not(.t-amp) { position: relative; }
  .t-kicker { font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--sage-soft); }
  .ticket .t-names { margin: 0.4rem 0 0.9rem; font-family: var(--script); font-weight: 400; font-size: 2.7rem; line-height: 1.05; text-transform: none; letter-spacing: normal; color: var(--sage); }
  .t-names span { display: block; font-size: 0.6em; color: var(--rose); }
  .t-meta { font-size: 0.92rem; line-height: 1.5; }
  .t-tag { margin-top: 0.6rem; font-size: 0.72rem; letter-spacing: 0.12em; color: var(--sage-soft); }
  .t-stub {
    --m-left: radial-gradient(circle var(--notch) at 0 0, #0000 98%, #000);
    --m-right: radial-gradient(circle var(--notch) at 100% 0, #0000 98%, #000);
    padding: 1.1rem 1.5rem 1.4rem; background: var(--sage); color: var(--paper);
    border-radius: 0 0 14px 14px;
    /* the perforation */
    background-image: linear-gradient(90deg, rgb(250 246 238 / 0.55) 50%, transparent 0);
    background-size: 10px 1.5px; background-repeat: repeat-x; background-position: 0 0;
  }
  .t-row { display: flex; justify-content: space-between; font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.8; }
  .t-guest { margin: 0.5rem 0 0.2rem; font-family: var(--script); font-size: 2rem; line-height: 1.2; overflow-wrap: anywhere; }
  .t-stub .wallet-btn { margin-top: 0.6rem; }
  .t-done {
    padding: 0.55rem 1.6rem; border-radius: 999px; border: 1px solid rgb(250 246 238 / 0.7);
    background: none; color: var(--paper); font: inherit; letter-spacing: 0.05em; cursor: pointer;
  }

  /* Apple's badge carries its own black fill and border, so the link only sizes it */
  .wallet-btn {
    display: inline-block; margin-top: 1.1rem; line-height: 0; border-radius: 9px;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .wallet-btn:active { transform: scale(0.97); }
  .wallet-btn img { display: block; height: 44px; width: auto; }
  .wallet-btn:focus-visible { outline: 2px solid var(--paper); outline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .countdown { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
  .countdown div { border: 1px solid var(--gold); padding: 0.7rem 0 0.5rem; background: #fffdf8; }
  .countdown b { display: block; font-size: 1.7rem; font-weight: 500; font-variant-numeric: lining-nums tabular-nums; }
  .countdown span { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--sage-soft); }

  .programme { list-style: none; padding: 0; position: relative; }
  .programme li { padding: 0.9rem 0; }
  .programme li + li { border-top: 1px dashed var(--gold); }
  .time { font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rose); font-weight: 600; }

  /* scroll reveal */
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1); }
  .reveal.in { opacity: 1; transform: none; }

  /* petals */
  .petals { position: fixed; inset: 0; pointer-events: none; z-index: 5; overflow: hidden; max-width: 480px; margin: 0 auto; }
  :global(.petal) {
    position: absolute; top: -20px; width: 10px; height: 13px;
    background: linear-gradient(135deg, #f7c6d0, #e8a5b3);
    border-radius: 80% 0 80% 0; opacity: 0.75;
    animation: fall linear infinite;
  }
  @keyframes fall {
    0% { transform: translate3d(0, -20px, 0) rotate(0deg); }
    50% { transform: translate3d(30px, 50vh, 0) rotate(200deg); }
    100% { transform: translate3d(-10px, 105vh, 0) rotate(400deg); }
  }

  /* dock + sheets */
  /* floating liquid-glass tab bar (LiquiKit, see components/AqilahDock.tsx) */
  .dock {
    position: fixed; left: 50%; z-index: 35; transform: translateX(-50%);
    bottom: calc(12px + env(safe-area-inset-bottom));
    --glass-accent: var(--sage);
    /* LiquiKit's font shorthand needs a real family here */
    --font-sans: 'Cormorant Garamond', Georgia, serif;
  }
  /* LiquiKit draws the bar inside a box with a 24px bleed; its default shadow
     (8px drop + 24px blur) reaches 32px down, so Safari cut it off in a straight
     line. Keep the shadow inside the bleed (6 + 16 = 22px). Inline style → !important. */
  .dock :global(.glass-pane > .glass > .glass__rim) {
    box-shadow: 0 6px 16px rgb(40 35 20 / 0.12), 0 1px 3px rgb(40 35 20 / 0.08) !important;
  }
  .sheet-backdrop { position: fixed; inset: 0; z-index: 25; background: rgb(40 35 25 / 0.35); animation: fade 250ms ease; }
  .sheet {
    position: fixed; left: 50%; bottom: 0; z-index: 30;
    width: 100%; max-width: 480px; transform: translateX(-50%);
    background: var(--paper); border-radius: 16px 16px 0 0;
    padding: 1.5rem 1.5rem calc(6.5rem + env(safe-area-inset-bottom)); text-align: center;
    animation: up 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sheet ul { list-style: none; padding: 0; text-align: left; }
  .sheet li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.75rem 0; }
  .sheet li + li { border-top: 1px dashed var(--gold); }
  .sheet .row { display: flex; gap: 0.4rem; flex-shrink: 0; }
  .sheet .buttons { margin-top: 1rem; }
  .sheet[hidden], .sheet-backdrop[hidden] { display: none; }
  .qr {
    width: min(56vw, 200px); aspect-ratio: 1; margin: 1rem auto 0.5rem;
    padding: 14px; background: #fff; border-radius: 16px; border: 1px solid var(--gold);
  }
  .qr :global(svg) { display: block; width: 100%; height: 100%; }
  .sheet button.btn { font-family: inherit; cursor: pointer; background: none; }
  @keyframes up { from { transform: translate(-50%, 100%); } }
  @keyframes fade { from { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .envelope, .stage-hint { animation: none; }
    .env-flap, .env-letter, .env-seal, .reveal { transition-duration: 1ms !important; transition-delay: 0ms !important; }
    .petals { display: none; }
  }
</style>

<script>
  const stage = document.getElementById('envelope-stage')!
  const envelope = document.getElementById('envelope')!
  const card = document.getElementById('card')!
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches

  document.body.classList.add('locked')

  const letter = envelope.querySelector<HTMLElement>('.env-letter')!
  const heroImg = document.querySelector<HTMLImageElement>('.hero img')!

  // Shared-element transition: the letter sticking out of the envelope grows
  // into the full-size hero card. A fixed "flyer" holds the hero image at its
  // final size; it starts transformed + clipped to exactly what the letter
  // showed (its top strip, cut by the envelope's V pocket) and animates to
  // identity, so letter → card is one continuous object.
  function morphLetter(flyer: HTMLElement) {
    const L = letter.getBoundingClientRect()
    const E = envelope.getBoundingClientRect()
    const H = heroImg.getBoundingClientRect()
    const s = L.width / H.width
    const W = H.width, Hh = H.height

    // visible part of the letter, in the flyer's own (unscaled) coordinates
    const toLocalY = (y: number) => Math.max(0, Math.min(Hh, (y - L.top) / s))
    const toLocalX = (x: number) => (x - L.left) / s
    const vY = (x: number) => E.top + (Math.abs(x - (E.left + E.width / 2)) <= E.width / 2
      ? (1 - Math.abs(x - (E.left + E.width / 2)) / (E.width / 2)) * 0.52 * E.height : 0)
    const bottom = toLocalY(L.bottom)
    const edgeY = Math.min(bottom, toLocalY(vY(L.left)))
    const midY = Math.min(bottom, toLocalY(E.top + 0.52 * E.height))
    // where the V meets the letter's bottom edge (or the V's tip if it is higher)
    const half = midY < bottom ? 0 : (1 - (L.bottom - E.top) / (0.52 * E.height)) * (E.width / 2)
    const xl = toLocalX(E.left + E.width / 2 - Math.max(0, half))
    const xr = toLocalX(E.left + E.width / 2 + Math.max(0, half))
    const from = `polygon(0px 0px, ${W}px 0px, ${W}px ${edgeY}px, ${xr}px ${midY}px, ${xl}px ${midY}px, 0px ${edgeY}px)`
    const to = `polygon(0px 0px, ${W}px 0px, ${W}px ${Hh}px, ${W}px ${Hh}px, 0px ${Hh}px, 0px ${Hh}px)`

    // inline styles: this element is created by script, so the page's scoped CSS can't reach it
    flyer.style.cssText = `position:fixed;z-index:60;overflow:hidden;pointer-events:none;transform-origin:0 0;will-change:transform,clip-path;left:${H.left}px;top:${H.top}px;width:${W}px;height:${Hh}px`
    letter.style.visibility = 'hidden'
    heroImg.style.visibility = 'hidden'

    const ease = 'cubic-bezier(0.32, 0.72, 0, 1)'
    const anim = flyer.animate(
      [
        { transform: `translate(${L.left - H.left}px, ${L.top - H.top}px) scale(${s})`, clipPath: from },
        { transform: 'none', clipPath: to },
      ],
      { duration: 800, easing: ease, fill: 'both' },
    )
    return anim.finished.then(() => {
      heroImg.style.visibility = ''
      flyer.remove()
    })
  }

  envelope.addEventListener('click', async () => {
    if (stage.classList.contains('opening')) return
    stage.classList.add('opening')
    window.scrollTo(0, 0)

    // build the flyer now so its image is decoded before the handoff
    const flyer = document.createElement('div')
    flyer.className = 'flyer'
    flyer.setAttribute('aria-hidden', 'true')
    const img = new Image()
    img.src = heroImg.currentSrc || heroImg.src
    img.alt = ''
    img.style.cssText = 'display:block;width:100%;height:100%'
    flyer.append(img)
    const decoded = img.decode().catch(() => {})

    await new Promise((r) => setTimeout(r, reduced ? 50 : 1150)) // letter has risen
    await decoded

    const reveal = () => {
      stage.classList.add('gone')
      stage.setAttribute('aria-hidden', 'true')
      card.removeAttribute('inert')
      document.body.classList.remove('locked')
    }
    if (reduced) { reveal(); startPetals(); return }

    document.body.append(flyer)
    const landed = morphLetter(flyer)
    reveal() // envelope + backdrop dissolve while the letter grows
    await landed
    startPetals()
  })

  // scroll reveal
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.classList.add('in')
        io.unobserve(e.target)
      }
    }
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' })
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el))

  // falling petals
  function startPetals() {
    if (reduced) return
    const box = document.querySelector('.petals')!
    for (let i = 0; i < 14; i++) {
      const p = document.createElement('span')
      p.className = 'petal'
      p.style.left = `${Math.random() * 100}%`
      p.style.animationDuration = `${9 + Math.random() * 8}s`
      p.style.animationDelay = `${Math.random() * 10}s`
      const s = 0.6 + Math.random() * 0.7
      p.style.width = `${10 * s}px`
      p.style.height = `${13 * s}px`
      box.appendChild(p)
    }
  }

  // countdown
  const cd = document.querySelector<HTMLElement>('.countdown')!
  const target = new Date(cd.dataset.target!).getTime()
  const units = {
    d: cd.querySelector('[data-unit="d"]')!,
    h: cd.querySelector('[data-unit="h"]')!,
    m: cd.querySelector('[data-unit="m"]')!,
    s: cd.querySelector('[data-unit="s"]')!,
  }
  function tick() {
    const diff = Math.max(0, target - Date.now())
    units.d.textContent = String(Math.floor(diff / 86400000))
    units.h.textContent = String(Math.floor((diff / 3600000) % 24)).padStart(2, '0')
    units.m.textContent = String(Math.floor((diff / 60000) % 60)).padStart(2, '0')
    units.s.textContent = String(Math.floor((diff / 1000) % 60)).padStart(2, '0')
  }
  tick()
  setInterval(tick, 1000)

  // RSVP → Apple Wallet pass
  const form = document.getElementById('rsvp-form') as HTMLFormElement
  const done = document.getElementById('rsvp-done')!
  const errorEl = document.getElementById('rsvp-error')!
  const STORE = 'aqilah-rsvp'

  type Guest = { id: string; name: string }
  const overlay = document.getElementById('ticket-overlay')!
  const ticket = document.getElementById('ticket')!
  const doneBtn = document.getElementById('ticket-done')!
  const openBtn = document.getElementById('ticket-open')!
  let current: Guest | null = null

  function showDone(guest: Guest) {
    current = guest
    form.hidden = true
    done.hidden = false
    document.getElementById('rsvp-who')!.textContent = guest.name
    document.getElementById('ticket-guest')!.textContent = guest.name
    document.getElementById('ticket-no')!.textContent = guest.id.slice(0, 6).toUpperCase()
    ;(document.getElementById('wallet-btn') as HTMLAnchorElement).href = `/api/aqilah/pass/${guest.id}.pkpass`
  }

  // The ticket arrives small and sideways, then turns upright as it grows —
  // like being handed a ticket. One continuous motion; Done fades in as it lands.
  function openTicket() {
    if (!current || !overlay.hidden) return
    overlay.hidden = false
    document.body.classList.add('locked')
    if (reduced) {
      overlay.animate({ opacity: [0, 1] }, { duration: 200 })
    } else {
      overlay.animate({ opacity: [0, 1] }, { duration: 250, easing: 'ease-out' })
      ticket.animate(
        [
          { transform: 'translateY(35vh) rotate(-90deg) scale(0.42)', opacity: 0, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          { transform: 'translateY(0) rotate(-90deg) scale(0.55)', opacity: 1, offset: 0.3, easing: 'cubic-bezier(0.34, 1.25, 0.64, 1)' },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 1000, fill: 'backwards' },
      )
      doneBtn.animate({ opacity: [0, 1] }, { duration: 300, delay: 750, fill: 'backwards', easing: 'ease-out' })
    }
    doneBtn.focus({ preventScroll: true })
  }

  async function closeTicket() {
    if (overlay.hidden) return
    const out = { duration: 180, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' as const }
    const a = overlay.animate({ opacity: [1, 0] }, out)
    ticket.animate({ transform: ['none', 'translateY(12px) scale(0.96)'] }, out)
    await a.finished
    overlay.hidden = true
    overlay.getAnimations().forEach((x) => x.cancel())
    ticket.getAnimations().forEach((x) => x.cancel())
    document.body.classList.remove('locked')
    openBtn.focus({ preventScroll: true })
  }

  openBtn.addEventListener('click', openTicket)
  doneBtn.addEventListener('click', closeTicket)
  overlay.addEventListener('click', (e) => e.target === overlay && closeTicket())
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeTicket())

  try {
    const saved = localStorage.getItem(STORE)
    if (saved) showDone(JSON.parse(saved))
  } catch {}

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const button = form.querySelector('button')!
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim()
    if (!name) return
    button.disabled = true
    errorEl.hidden = true
    try {
      const res = await fetch('/api/aqilah/rsvp', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name }),
      })
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      const guest = await res.json()
      try { localStorage.setItem(STORE, JSON.stringify(guest)) } catch {}
      showDone(guest)
      openTicket()
    } catch {
      errorEl.textContent = 'Maaf, cuba lagi · Sorry, please try again'
      errorEl.hidden = false
    } finally {
      button.disabled = false
    }
  })

  // bottom sheets
  const backdrop = document.getElementById('sheet-backdrop')!
  let openSheet: HTMLElement | null = null
  function closeSheet() {
    if (!openSheet) return
    openSheet.setAttribute('hidden', '')
    backdrop.setAttribute('hidden', '')
    openSheet = null
    window.dispatchEvent(new Event('sheet:closed'))
  }
  // the React tab bar asks for sheets through these events
  window.addEventListener('dock:close', closeSheet)

  // share sheet
  const shareUrl = location.origin + location.pathname
  const shareNative = document.getElementById('share-native')!
  const shareCopy = document.getElementById('share-copy')!
  if (navigator.share) {
    shareNative.hidden = false
    shareNative.addEventListener('click', () => {
      navigator.share({ title: document.title, text: "You're invited to Irsyad & 'Aqilah's walimah", url: shareUrl }).catch(() => {})
    })
  }
  shareCopy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(shareUrl)
      shareCopy.textContent = 'Copied ✓'
    } catch {
      shareCopy.textContent = shareUrl
    }
    setTimeout(() => (shareCopy.textContent = 'Copy link'), 2000)
  })
  window.addEventListener('dock:open', (e) => {
    const sheet = document.getElementById((e as CustomEvent<string>).detail)!
    if (openSheet === sheet) return
    openSheet?.setAttribute('hidden', '')
    sheet.removeAttribute('hidden')
    backdrop.removeAttribute('hidden')
    openSheet = sheet
  })
  backdrop.addEventListener('click', closeSheet)
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeSheet())
</script>
